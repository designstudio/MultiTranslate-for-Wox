{
  "Id": "e1dfeb8d-6469-4762-8f3e-7c739f54cc12",
  "Name": "MultiTranslate for Wox",
  "Description": "Multi-provider translation for Wox. Google, Microsoft, DeepL and more. UI follows the Wox language automatically.",
  "Author": "Lu-Jiejie (original translation adapters); Wox community port",
  "Website": "https://github.com/Lu-Jiejie/flow-launcher-multi-translate",
  "Version": "0.3.8",
  "MinWoxVersion": "2.4.5",
  "Runtime": "nodejs",
  "Entry": "index.js",
  "Icon": "relative:assets/icon.png",
  "TriggerKeywords": [
    "tr"
  ],
  "SupportedOS": [
    "windows",
    "linux",
    "darwin"
  ],
  "SettingDefinitions": [
    {
      "Type": "select",
      "Value": {
        "Key": "translation_mode",
        "Label": "i18n:mode_label",
        "DefaultValue": "configured",
        "Options": [
          {
            "Label": "i18n:mode_configured",
            "Value": "configured"
          },
          {
            "Label": "i18n:mode_zh_en",
            "Value": "zh-en"
          }
        ]
      }
    },
    {
      "Type": "textbox",
      "Value": {
        "Key": "source_language",
        "Label": "i18n:source_label",
        "DefaultValue": "auto"
      }
    },
    {
      "Type": "textbox",
      "Value": {
        "Key": "target_language",
        "Label": "i18n:target_label",
        "DefaultValue": "pt_br"
      }
    },
    {
      "Type": "textbox",
      "Value": {
        "Key": "providers",
        "Label": "i18n:providers_label",
        "DefaultValue": "google",
        "MaxLines": 10
      }
    },
    {
      "Type": "textbox",
      "Value": {
        "Key": "language_pairs",
        "Label": "i18n:pairs_label",
        "DefaultValue": "en>pt_br\npt_br>en",
        "MaxLines": 8
      }
    },
    {
      "Type": "textbox",
      "Value": {
        "Key": "timeout_ms",
        "Label": "i18n:timeout_label",
        "DefaultValue": "12000"
      }
    },
    {
      "Type": "textbox",
      "Value": {
        "Key": "delay_ms",
        "Label": "i18n:delay_label",
        "DefaultValue": "300"
      }
    },
    {
      "Type": "textbox",
      "Value": {
        "Key": "deepl_key",
        "Label": "i18n:deepl_key_label",
        "DefaultValue": ""
      }
    },
    {
      "Type": "textbox",
      "Value": {
        "Key": "deeplx_url",
        "Label": "i18n:deeplx_url_label",
        "DefaultValue": ""
      }
    },
    {
      "Type": "textbox",
      "Value": {
        "Key": "mtran_url",
        "Label": "i18n:mtran_url_label",
        "DefaultValue": ""
      }
    },
    {
      "Type": "textbox",
      "Value": {
        "Key": "mtran_token",
        "Label": "i18n:mtran_token_label",
        "DefaultValue": ""
      }
    },
    {
      "Type": "textbox",
      "Value": {
        "Key": "openai_base_url",
        "Label": "i18n:openai_base_url_label",
        "DefaultValue": "https://api.openai.com/v1"
      }
    },
    {
      "Type": "textbox",
      "Value": {
        "Key": "openai_api_key",
        "Label": "i18n:openai_api_key_label",
        "DefaultValue": ""
      }
    },
    {
      "Type": "textbox",
      "Value": {
        "Key": "openai_model",
        "Label": "i18n:openai_model_label",
        "DefaultValue": "gpt-4o-mini"
      }
    },
    {
      "Type": "textbox",
      "Value": {
        "Key": "openai_system_prompt",
        "Label": "i18n:openai_system_prompt_label",
        "DefaultValue": ""
      }
    },
    {
      "Type": "textbox",
      "Value": {
        "Key": "openai_user_prompt",
        "Label": "i18n:openai_user_prompt_label",
        "DefaultValue": ""
      }
    },
    {
      "Type": "textbox",
      "Value": {
        "Key": "openai_language_names",
        "Label": "i18n:openai_language_names_label",
        "DefaultValue": ""
      }
    }
  ],
  "I18n": {
    "en_US": {
